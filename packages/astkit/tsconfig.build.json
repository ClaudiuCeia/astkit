{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "rewriteRelativeImportExtensions": true,
    "tsBuildInfoFile": "./tsconfig.build.tsbuildinfo",
    "paths": {
      "@claudiu-ceia/astkit-core": ["../astkit-core/dist/index.d.ts"],
      "@claudiu-ceia/spatch": ["../spatch/dist/index.d.ts"],
      "@claudiu-ceia/spatch/internal/command": ["../spatch/dist/internal/command.d.ts"],
      "@claudiu-ceia/sgrep": ["../sgrep/dist/index.d.ts"],
      "@claudiu-ceia/nav": ["../nav/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**"],
  "references": [
    { "path": "../spatch/tsconfig.build.json" },
    { "path": "../sgrep/tsconfig.build.json" },
    { "path": "../nav/tsconfig.build.json" }
  ]
}
