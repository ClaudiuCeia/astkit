{
  "name": "@claudiu-ceia/spatch",
  "version": "0.4.1",
  "description": "Structural patcher for TS/JS using a patch-document template format.",
  "homepage": "https://github.com/ClaudiuCeia/astkit/tree/main/packages/spatch#readme",
  "bugs": {
    "url": "https://github.com/ClaudiuCeia/astkit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClaudiuCeia/astkit.git",
    "directory": "packages/spatch"
  },
  "bin": {
    "spatch": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal/command": {
      "types": "./dist/internal/command.d.ts",
      "bun": "./src/internal/command.ts",
      "import": "./dist/internal/command.js",
      "default": "./dist/internal/command.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@claudiu-ceia/astkit-core": "^0.3.1",
    "@claudiu-ceia/combine": "^0.6.1",
    "@stricli/core": "^1.3.0",
    "chalk": "^6.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
